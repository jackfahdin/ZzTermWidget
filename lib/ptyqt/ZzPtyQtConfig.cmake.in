@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Resolve the same Qt the library was built against (Qt6 now, Qt7 in the future).
find_dependency(QT NAMES Qt6 Qt7 COMPONENTS Core Network)
find_dependency(Qt${QT_VERSION_MAJOR} COMPONENTS Core Network)

include("${CMAKE_CURRENT_LIST_DIR}/ZzPtyQtTargets.cmake")

check_required_components(ZzPtyQt)
